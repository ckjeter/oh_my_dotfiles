# shared by the macOS laptop and Linux dev servers
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind-key Z select-layout tiled

# Nested sessions (local tmux -> ssh -> remote tmux) share this prefix.
# C-a C-a <key> reaches the inner session. F12 goes further and mutes the outer
# one entirely, so every key including the bare prefix lands inside. F12 again
# takes control back.
bind-key -T root F12 \
  set prefix None \;\
  set key-table off \;\
  set status-style 'fg=#585b70,bg=#11111b' \;\
  refresh-client -S
bind-key -T off F12 \
  set -u prefix \;\
  set -u key-table \;\
  set -u status-style \;\
  refresh-client -S
# prefix + Tab: fzf window switcher, ordered by how recently each window was
# focused (true per-window MRU, not clumped by session), with a marker and the
# task for any window running a coding agent. See scripts/tmux-mru.sh.
bind-key Tab display-popup -E -w 80% -h 70% "~/.dotfiles/scripts/tmux-mru.sh switch"
# prefix + a: throwaway floating shell in the current pane's directory. exit or
# C-d closes it.
bind-key a display-popup -E -w 80% -h 75% -d "#{pane_current_path}"
# feed the MRU stack: record the focused window on every window/session change.
set-hook -g session-window-changed "run-shell -b \"~/.dotfiles/scripts/tmux-mru.sh record '#{session_name}:#{window_index}'\""
set-hook -g client-session-changed "run-shell -b \"~/.dotfiles/scripts/tmux-mru.sh record '#{session_name}:#{window_index}'\""
set -s escape-time 0
set -g focus-events on
# send copies to the outer terminal via OSC 52 so yanking works over SSH
set -g set-clipboard on

set -g default-shell /bin/zsh
set -g allow-rename off
set -g automatic-rename off
setw -g mode-keys vi
set -g pane-border-status "off"
set -g pane-border-format "[#[fg=white]#{?pane_active,#[bold],} #P: #{pane_current_command} #[fg=default,nobold]]"

# Auto hide pane-border-status line when only one pane is displayed (see tmux/tmux#566)
set-hook -g 'after-new-session'  'run-shell -b "if [ \#{window_panes} -eq 1 ]; then tmux set pane-border-status off; fi"'
set-hook -g 'after-new-window'   'run-shell -b "if [ \#{window_panes} -eq 1 ]; then tmux set pane-border-status off; fi"'
set-hook -g 'after-kill-pane'    'run-shell -b "if [ \#{window_panes} -eq 1 ]; then tmux set pane-border-status off; fi"'
set-hook -g 'pane-exited'        'run-shell -b "if [ \#{window_panes} -eq 1 ]; then tmux set pane-border-status off; fi"'
set-hook -g 'after-split-window' 'run-shell -b "if [ \#{window_panes} -gt 1 ]; then tmux set pane-border-status top; fi"'

#Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'tmux-plugins/tmux-pain-control'
set -g @plugin 'catppuccin/tmux'
set -g @plugin 'tmux-plugins/tmux-sessionist'
set -g @plugin 'tmux-plugins/tmux-open'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'ChanderG/tmux-notify'

# Several tmux servers load this file. The main one is the default socket and
# holds your own sessions. agent-deck (tmux -L agent-deck) and the lazyagent
# dashboard (tmux -L lazyagent-dashboard-*) start their own. Everything that
# differs between them keys off this flag.
set -gF @main_server '#{==:#{b:socket_path},default}'

set -g @continuum-save-interval '15'
set -g @resurrect-hook-post-save-layout 'sh ~/.dotfiles/scripts/tmux-resurrect-filter.sh'
# Only the main server restores and autosaves. Restoring on another server
# would pull the main sessions into it, and its saves would replace the main
# one, so the others keep their own resurrect dir and never autosave.
# continuum's own restore is off everywhere because it skips itself whenever
# any other tmux server is running. The main server restores below instead.
set -g @continuum-restore 'off'
if-shell -F '#{?@main_server,0,1}' {
  set -gF @resurrect-dir '~/.tmux/resurrect-#{b:socket_path}'
  set -g @continuum-save-interval '0'
}


#Status Bar
set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_window_status_style 'rounded'
set -g @catppuccin_window_text ' #W '
set -g @catppuccin_window_current_text ' #W '
# agent-deck starts each agent through bash and automatic-rename is off, so the
# agent's window reads "bash". Show the session's agent-deck title there
# instead. It follows a rename in agent-deck and leaves renamed windows alone.
if-shell -F '#{?@main_server,0,1}' {
  set -g @catppuccin_window_text ' #{?#{&&:#{@agentdeck_display_name},#{==:#{window_name},bash}},#{@agentdeck_display_name},#W} '
  set -g @catppuccin_window_current_text ' #{?#{&&:#{@agentdeck_display_name},#{==:#{window_name},bash}},#{@agentdeck_display_name},#W} '
}

# Module options (must be set before plugin loads)
set -g @catppuccin_date_time_text ' %a %H:%M'

# tmux-battery uses one-time string replacement in status-right at load time,
# which is incompatible with catppuccin v2's deferred option expansion.
# Override with direct script paths so they resolve at render time.
set -g @catppuccin_battery_icon "#(~/.tmux/plugins/tmux-battery/scripts/battery_icon.sh) "
set -g @catppuccin_battery_text " #(~/.tmux/plugins/tmux-battery/scripts/battery_percentage.sh)"

run '~/.tmux/plugins/tpm/tpm'

# tmux-yank shells out to pbcopy on macOS and xclip/xsel on Linux. A headless
# server has neither, so keep tmux's own copy there and let set-clipboard
# forward it to the local machine.
if-shell '[ "$(uname)" != Darwin ]' {
  bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
  bind-key -T copy-mode-vi M-y send-keys -X copy-selection-and-cancel \; paste-buffer -p
  bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel
  bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-selection-and-cancel
}

# Status bar layout (v2 API — must come after plugin load)
set -g status-left-length 100
set -g status-right-length 100
# The main server shows the session label. On the agent-deck server
# status-left is its notification bar while a session is waiting, and empty
# otherwise (tmux-side-status.sh puts the group and session names next to the
# windows). A reload leaves a live bar alone: agent-deck only rewrites it when
# its content changes.
if-shell -F '#{@main_server}' {
  set -g status-left "#{E:@catppuccin_status_session} #[bg=default] "
} {
  if-shell -F '#{m:⚡ *,#{status-left}}' '' 'set -g status-left ""'
  set -g status-left-style 'fg=#f9e2af,bold'
  run-shell 'sh ~/.dotfiles/scripts/tmux-side-status.sh'
}
# Remote machines name themselves in a pill at the right end, set in
# hosts/<hostname>.tmux (@host_name, @host_color, @host_icon), so each server
# gets its own color. A machine without that file is the local one and shows
# no pill. In a nested session the inner bar sits above the outer one. Only
# the laptop has a battery. Kept in a user option so agent-deck, which sets
# status-right on each of its sessions, can point at the same value from one
# config.toml on every machine (see agent-deck/tmux.toml).
set -g @host_name ''
set -g @host_color '#f9e2af'
set -g @host_icon '󰒋'
source-file -qF "~/.dotfiles/hosts/#{host_short}.tmux"
set -g @host_pill '#[fg=#{@host_color}]#[fg=#11111b,bg=#{@host_color}]#{@host_icon} #[fg=#cdd6f4,bg=#313244] #{E:@host_name}#[fg=#313244] #[default]'
set -g @status_host '#{?@host_name, #{E:@host_pill},}'
if-shell '[ "$(uname)" = Darwin ]' \
  'set -g @status_right_main "#{E:@catppuccin_status_battery} #{E:@catppuccin_status_date_time}#{E:@status_host}"' \
  'set -g @status_right_main "#{E:@catppuccin_status_date_time}#{E:@status_host}"'
set -g status-right '#{E:@status_right_main}'
# continuum autosaves from a script it puts in status-right while tpm loads,
# which the line above replaces. Put it back. It prints nothing.
if-shell -F '#{@main_server}' {
  set -ga status-right '#(~/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh)'
  # restore once, on the first load of a freshly started main server
  if-shell '[ $(( $(date +%s) - #{start_time} )) -lt 15 ]' \
    'run-shell -b "~/.tmux/plugins/tmux-resurrect/scripts/restore.sh"'
}

# tmux 3.8 underlines the current window by default. catppuccin already
# colors it, and the underline would also run under the side-server pills.
set -g window-status-current-style default

# Pane border colors (Catppuccin Mocha)
set -g pane-border-lines heavy
set -g pane-border-style 'fg=#45475a'
set -g pane-active-border-style 'fg=#cba6f7'

# Inactive pane background tint
set -g window-style 'fg=#585b70,bg=#11111b'
set -g window-active-style 'fg=#cdd6f4,bg=#1e1e2e'

# agent-deck configuration
# agent-deck-tmux-config-version: 4
# Taken over from the agent-deck installer and trimmed to what the rest of
# this file lacks. The markers stay so a re-run of its installer sees v4 and
# leaves the file alone. A newer version would rewrite it and replace the
# ~/.tmux.conf symlink with a plain file, so install and upgrade agent-deck
# with --skip-tmux-config (see scripts/requirements.tsv).
set -g history-limit 50000
set -g mouse on
# Shift+Enter and other modified keys reach the agent. Claude Code reads the
# csi-u form, which needs tmux 3.5+. Ubuntu 24.04 ships 3.4.
set -s extended-keys on
if-shell -F '#{>=:#{version},3.5}' 'set -s extended-keys-format csi-u'
set -as terminal-features 'tmux-256color:extkeys'
# scrolling up enters copy-mode unless the app wants the mouse itself
bind-key -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e'"
bind-key -T copy-mode-vi WheelUpPane send-keys -X scroll-up
bind-key -T copy-mode-vi WheelDownPane send-keys -X scroll-down
bind-key -T copy-mode WheelUpPane send-keys -X scroll-up
bind-key -T copy-mode WheelDownPane send-keys -X scroll-down
# End agent-deck configuration

