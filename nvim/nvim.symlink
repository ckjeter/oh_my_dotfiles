"General Setting------------------------------
set encoding=utf-8
set t_Co=256
set background=dark
set tabstop=4 softtabstop=4 shiftwidth=4
autocmd FileType typescript,javascript,typescriptreact,javascriptreact setlocal shiftwidth=4 tabstop=4 expandtab
set expandtab
set guifont=Fira\ Code:h12
set scrolloff=10
set ai
set nowrap
set number
set ruler
set hlsearch
set cursorline
set hidden
set clipboard=unnamed
set autoread
set updatetime=300
set completeopt-=preview
set backspace=indent,eol,start
let &t_SI = "\e[5 q"
let &t_EI = "\e[2 q"
nnoremap d "_d
vnoremap d "_d

"nmap---------------------------------
map <leader>f :silent! NERDTreeToggle<CR>
nmap <C-P> :Files<CR>
nmap <C-e> :Buffers<CR>
let g:fzf_action = { 'ctrl-e': 'edit' }
nnoremap <silent> <Leader>p :Rg<CR>

"neovim only below--------------------
" Plain vim (macOS system vim, Ubuntu vim) is built without +lua and cannot
" parse the lua blocks below. It keeps the settings above and stops here.
if !has('nvim')
  finish
endif

"clipboard----------------------------
" A headless server has no X clipboard, and setting 'clipboard' suppresses
" nvim's own OSC 52 fallback, so ask for it explicitly. Inside tmux the tmux
" provider already forwards yanks through set-clipboard.
if !empty($SSH_TTY) && empty($TMUX)
  let g:clipboard = 'osc52'
endif

"plugins------------------------------
" coc and copilot are node processes; a bare server may not have node
let s:has_node = executable('node')

call plug#begin('~/.config/nvim/plugged')

Plug 'preservim/nerdtree'
Plug 'Xuyuanp/nerdtree-git-plugin'
Plug 'tiagofumo/vim-nerdtree-syntax-highlight'
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'
Plug 'ryanoasis/vim-devicons'
Plug 'catppuccin/nvim', { 'as': 'catppuccin' }
Plug 'APZelos/blamer.nvim'
Plug 'MattesGroeger/vim-bookmarks'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-repeat'
Plug 'yuezk/vim-js'
Plug 'maxmellon/vim-jsx-pretty'
Plug 'christoomey/vim-tmux-navigator'
Plug 'sindrets/diffview.nvim'
Plug 'nvim-treesitter/nvim-treesitter'
Plug 'MeanderingProgrammer/render-markdown.nvim'
Plug 'nvim-lualine/lualine.nvim'
Plug 'akinsho/bufferline.nvim'

if s:has_node
  Plug 'neoclide/coc.nvim', {'branch': 'release'}
  Plug 'github/copilot.vim'
endif

call plug#end()

"theme--------------------------------
filetype plugin on
syntax enable
set bg=dark
set termguicolors

lua << EOF
local ok, catppuccin = pcall(require, 'catppuccin')
if ok then
  catppuccin.setup({
    flavour = 'mocha',
    integrations = {
      coc_nvim = true,
      gitgutter = true,
      nerdtree = true,
      lualine = true,
      bufferline = true,
    },
  })
  vim.cmd('colorscheme catppuccin')
end

vim.api.nvim_create_autocmd('FocusLost', {
  callback = function()
    vim.api.nvim_set_hl(0, 'Normal', { bg = '#11111b' })
  end,
})
vim.api.nvim_create_autocmd('FocusGained', {
  callback = function()
    vim.cmd('colorscheme catppuccin')
  end,
})

local ok_ll, lualine = pcall(require, 'lualine')
if ok_ll then
  lualine.setup({})
end

local ok_bl, bufferline = pcall(require, 'bufferline')
if ok_bl then
  local bl_opts = { options = { separator_style = 'slant' } }
  local ok_hl, hl = pcall(require, 'catppuccin.groups.integrations.bufferline')
  if ok_hl then bl_opts.highlights = hl.get() end
  bufferline.setup(bl_opts)
end
EOF

" Fancy Symbols!!
let g:webdevicons_enable = 1

"NerdTree-----------------------------
autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() |
   \ quit | endif
"autocmd VimEnter * NERDTree | wincmd p
autocmd BufWinEnter * silent NERDTreeMirror
let NERDTreeIgnore = ['\.pyc$', '__pycache__']
let NERDTreeShowHidden=1
let g:WebDevIconsUnicodeDecorateFolderNodes = 1
let g:WebDevIconsUnicodeDecorateFileNodes = 1
let g:DevIconsEnableFolderExtensionPatternMatching = 1
let g:WebDevIconsNerdTreePlugin = 1
let g:NERDTreeHighlightFolders = 1
let g:NERDTreeShowLineNumbers = 1
let g:NERDTreeQuitOnOpen = 0

"nerdtree-git-plugin------------------
" show git status next to each file, VSCode/Cursor style, for reviewing
" agent-written changes. Nerd font glyphs since devicons already needs them.
let g:NERDTreeGitStatusUseNerdFonts = 1
" also flag folders that contain changes, so a dirty subtree is visible collapsed
let g:NERDTreeGitStatusShowClean = 0
let g:NERDTreeGitStatusConcealBrackets = 1

"fzf----------------------------------
let g:fzf_default_command = 'Hidden Files'

"coc----------------------------------
if s:has_node
  set completeopt=menuone,noinsert,noselect
  autocmd CursorHold * silent call CocActionAsync('highlight')
endif

"vim-bookmark-------------------------
let g:bookmark_save_per_working_dir = 1
let g:bookmark_auto_save = 1

"jsx_pretty
let g:vim_jsx_pretty_colorful_config = 1

"copilot
if s:has_node
  let g:copilot_enabled = 1
  let g:copilot_no_tab_map = v:true
  inoremap <silent><script><expr> <Tab> copilot#Accept("\<Tab>")
endif

inoremap <silent><expr> <S-Tab>
      \ pumvisible() ? "\<C-p>" : "\<C-g>U\<C-w>"

"gitlens-----------------------------
let g:blamer_enabled = 1
let g:blamer_show_in_visual_modes = 0
let g:blamer_show_in_insert_modes = 0

"markdown--------------------------------
autocmd FileType markdown setlocal wrap linebreak nolist
autocmd FileType markdown setlocal spell spelllang=en_us

lua << EOF
local ok_ts, ts = pcall(require, 'nvim-treesitter.configs')
if ok_ts then
  -- parsers are compiled on install; skip that on a box with no C compiler
  local can_compile = vim.fn.executable('cc') == 1 or vim.fn.executable('gcc') == 1
  ts.setup({
    ensure_installed = can_compile and { 'markdown', 'markdown_inline' } or {},
    highlight = {
      enable = true,
      disable = function(lang)
        return lang ~= 'markdown' and lang ~= 'markdown_inline'
      end,
    },
  })
end

local ok_rm, rm = pcall(require, 'render-markdown')
if ok_rm then
  rm.setup({})
end
EOF

"diffview--------------------------------
lua pcall(function() require('diffview').setup({}) end)
nnoremap <leader>dv :DiffviewOpen<CR>
nnoremap <leader>dc :DiffviewClose<CR>
nnoremap <leader>dh :DiffviewFileHistory %<CR>

"wrap toggle---------------------------------
nnoremap <leader>w :set wrap! linebreak!<CR>
