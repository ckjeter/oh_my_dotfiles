"General Setting------------------------------
set encoding=utf-8
set t_Co=256
set background=dark
set tabstop=4 softtabstop=4 shiftwidth=4
autocmd FileType typescript,javascript,typescriptreact,javascriptreact setlocal shiftwidth=4 tabstop=4 expandtab
set expandtab
set guifont=Fira\ Code:h12
set scrolloff=10
set ai
set nowrap
set number
set ruler
set hlsearch
set cursorline
set hidden
set clipboard=unnamed
set autoread
set completeopt-=preview
set backspace=indent,eol,start
let &t_SI = "\e[5 q"
let &t_EI = "\e[2 q"
nnoremap d "_d
vnoremap d "_d

"nmap---------------------------------
map <leader>f :silent! NERDTreeToggle<CR>
nmap <C-P> :Files<CR>
nmap <C-e> :Buffers<CR>
let g:fzf_action = { 'ctrl-e': 'edit' }
nnoremap <silent> <Leader>p :Rg<CR>

"plugins------------------------------
call plug#begin('~/.config/nvim/plugged')

Plug 'preservim/nerdtree'
Plug 'tiagofumo/vim-nerdtree-syntax-highlight'
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'
Plug 'ryanoasis/vim-devicons'
Plug 'catppuccin/nvim', { 'as': 'catppuccin' }
Plug 'APZelos/blamer.nvim'
Plug 'MattesGroeger/vim-bookmarks'
Plug 'neoclide/coc.nvim', {'branch': 'release'}
Plug 'tpope/vim-surround'
Plug 'tpope/vim-repeat'
Plug 'yuezk/vim-js'
Plug 'maxmellon/vim-jsx-pretty'
Plug 'github/copilot.vim'
Plug 'christoomey/vim-tmux-navigator'
Plug 'sindrets/diffview.nvim'
Plug 'nvim-treesitter/nvim-treesitter'
Plug 'MeanderingProgrammer/render-markdown.nvim'

call plug#end()

"theme--------------------------------
filetype plugin on
syntax enable
set bg=dark
set termguicolors

lua << EOF
local ok, catppuccin = pcall(require, 'catppuccin')
if ok then
  catppuccin.setup({
    flavour = 'mocha',
    integrations = {
      coc_nvim = true,
      gitgutter = true,
      nerdtree = true,
    },
  })
  vim.cmd('colorscheme catppuccin')
end
EOF

" Fancy Symbols!!
let g:webdevicons_enable = 1

"NerdTree-----------------------------
autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() |
   \ quit | endif
"autocmd VimEnter * NERDTree | wincmd p
autocmd BufWinEnter * silent NERDTreeMirror
let NERDTreeIgnore = ['\.pyc$', '__pycache__']
let NERDTreeShowHidden=1
let g:WebDevIconsUnicodeDecorateFolderNodes = 1
let g:WebDevIconsUnicodeDecorateFileNodes = 1
let g:DevIconsEnableFolderExtensionPatternMatching = 1
let g:WebDevIconsNerdTreePlugin = 1
let g:NERDTreeHighlightFolders = 1
let g:NERDTreeShowLineNumbers = 1
let g:NERDTreeQuitOnOpen = 0

"fzf----------------------------------
let g:fzf_default_command = 'Hidden Files'

"coc----------------------------------
set completeopt=menuone,noinsert,noselect
autocmd CursorHold * silent call CocActionAsync('highlight')

"vim-bookmark-------------------------
let g:bookmark_save_per_working_dir = 1
let g:bookmark_auto_save = 1

"jsx_pretty
let g:vim_jsx_pretty_colorful_config = 1

"copilot
let g:copilot_enabled = 1
let g:copilot_no_tab_map = v:true
inoremap <silent><script><expr> <Tab> copilot#Accept("\<Tab>")

inoremap <silent><expr> <S-Tab>
      \ pumvisible() ? "\<C-p>" : "\<C-g>U\<C-w>"

"gitlens-----------------------------
let g:blamer_enabled = 1
let g:blamer_show_in_visual_modes = 0
let g:blamer_show_in_insert_modes = 0

"markdown--------------------------------
autocmd FileType markdown setlocal wrap linebreak nolist
autocmd FileType markdown setlocal spell spelllang=en_us

lua << EOF
local ok_ts, ts = pcall(require, 'nvim-treesitter.configs')
if ok_ts then
  ts.setup({
    ensure_installed = { 'markdown', 'markdown_inline' },
    highlight = {
      enable = true,
      disable = function(lang)
        return lang ~= 'markdown' and lang ~= 'markdown_inline'
      end,
    },
  })
end

local ok_rm, rm = pcall(require, 'render-markdown')
if ok_rm then
  rm.setup({})
end
EOF

"diffview--------------------------------
lua require('diffview').setup({})
nnoremap <leader>dv :DiffviewOpen<CR>
nnoremap <leader>dc :DiffviewClose<CR>
nnoremap <leader>dh :DiffviewFileHistory %<CR>
